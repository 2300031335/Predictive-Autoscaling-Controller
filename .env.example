# Application Configuration
APP_NAME=Predictive Autoscaling Controller
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Forecasting Service Settings
FORECAST_HORIZON_MINUTES=5
FORECAST_INTERVAL_SECONDS=60
MODEL_TYPE=prophet
MODEL_SAVE_PATH=./data/processed/prophet_model.pkl

# Autoscaling Controller Policy Settings
MIN_REPLICAS=1
MAX_REPLICAS=10
SAFE_CAPACITY_PER_REPLICA=25.0
SAFETY_MARGIN_PERCENT=0.15
MAX_SCALE_UP_RATE=3
MAX_SCALE_DOWN_RATE=2
SCALE_UP_COOLDOWN_SECONDS=60
SCALE_DOWN_COOLDOWN_SECONDS=180
STALE_DATA_THRESHOLD_SECONDS=120
FORECAST_ERROR_FALLBACK_THRESHOLD=0.35

# Prometheus Metrics Exporter Port
PROMETHEUS_METRICS_PORT=8000
